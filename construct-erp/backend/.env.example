# ============================================
# ConstructERP India — Backend Environment
# ============================================

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construct_erp
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
SESSION_MAX_HOURS=8

# File Upload (AWS S3 or local)
UPLOAD_PROVIDER=local
UPLOAD_PATH=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=ap-south-1

# GST / TDS Config
DEFAULT_GST_RATE=18
TDS_194C_COMPANY=2
TDS_194C_INDIVIDUAL=1

# WhatsApp (Twilio or WATI)
# WHATSAPP_API_URL=
# WHATSAPP_TOKEN=

# Email (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# pg_dump path for automated backups
# Linux/Docker: leave unset (uses pg_dump from PATH)
# Windows: PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PG_DUMP_PATH=

# Backup directory (Docker: set to /app/backups — mapped to a named volume)
# BACKUP_DIR=/app/backups

# Log directory (Docker: set to /app/logs — mapped to a named volume)
# LOG_DIR=/app/logs

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:3000
