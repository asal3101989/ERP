# ============================================================
# Construction ERP Finance Module — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://erp_user:StrongPassword@localhost:5432/construction_erp"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-256-bit-secret-minimum-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-different-random-secret-for-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── Company Details (for TDS Form 26Q) ───────────────────────
COMPANY_NAME="BCIM Engineering Private Limited"
COMPANY_PAN="AAKCK1234A"
COMPANY_TAN="BLRA12345A"
COMPANY_GSTIN="29AAKCK1234A1Z5"

# ── File Storage (AWS S3 or local) ────────────────────────────
STORAGE_TYPE=local          # "local" or "s3"
LOCAL_UPLOAD_DIR="./uploads"
AWS_BUCKET_NAME=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Email (SMTP for notifications) ───────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@constructerp.in"

# ── Indian Banking APIs ───────────────────────────────────────
# IFSC validation: https://ifsc.razorpay.com/{IFSC}
# Bank account penny drop: Cashfree Payout API
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="TEST"   # "TEST" or "PROD"

# ── Redis (optional — for token blacklist & queues) ───────────
REDIS_URL="redis://localhost:6379"

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
